# Copy to .env and fill in real values. Never commit the real .env.

# MongoDB connection string (include a database name, e.g. .../resort)
MONGO_URL=mongodb://127.0.0.1:27017/resort

# Default admin, auto-seeded on server start if it does not already exist
ADMIN_NAME=Admin
ADMIN_USER=admin
ADMIN_PASS=change-me

# Secret used to sign admin JWTs — MUST be a long random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

PORT=3000

# Origins allowed by CORS. Must match where each frontend actually runs.
BACKEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
PRODUCTION_CLIENT_URL=
PRODUCTION_ADMIN_URL=

# Booking hold duration, and OTP validity window
EXPIRE_TIME=1h
OTP_EXPIRE_TIME=15m
